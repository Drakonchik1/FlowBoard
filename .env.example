# Copy this file to .env and replace values. .env is git-ignored — never commit it.
MSSQL_SA_PASSWORD=YOUR_STRONG_SA_PASSWORD_HERE
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Cursor SDK — agent-runner only (scripts/run-next-task.ps1). Not used by the API.
# Mint at Cursor Dashboard → API Keys: https://cursor.com/dashboard
CURSOR_API_KEY=

# Git author for agent-runner council-verify publish (optional if git config user.name/email is set).
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com

# Redis (Sprint 5 — SignalR backplane).
# Dev compose (docker compose up): API gets ConnectionStrings__Redis=redis:6379 — no password.
# Local dotnet run against dev compose Redis on the host:
REDIS_CONNECTION=localhost:6379
#
# Production compose (docker compose -f docker-compose.prod.yml up):
# Redis runs with --requirepass; API uses redis:6379,password=<REDIS_PASSWORD> (StackExchange.Redis format).
# Local dotnet run against prod compose Redis (if you expose it temporarily): localhost:6379,password=YOUR_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# SMTP (Sprint 6 — transactional email via MailKit). Required in Production for assignment emails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=FlowBoard

# Hangfire dashboard (/jobs) — comma-separated admin emails allowed past JWT + Admin policy.
# Hangfire__DashboardAdminEmails__0=admin@example.com

# Production CORS — required when ASPNETCORE_ENVIRONMENT=Production (docker-compose.prod.yml).
# Add AllowedOrigins__1, __2, ... for additional frontend origins.
ALLOWED_ORIGINS__0=https://your-app.example.com

# Optional — enable when API sits behind a reverse proxy (nginx, Railway, Azure, etc.)
# FORWARDED_HEADERS_ENABLED=true
# ForwardedHeaders__KnownProxies__0=10.0.0.1
# ForwardedHeaders__KnownProxies__1=172.16.0.1

# Production host allowlist (recommended). Default appsettings uses "*".
# AllowedHosts__0=api.your-app.example.com

# Registration — disabled by default in appsettings.Production.json (Auth__AllowRegistration=false).
# Auth__AllowRegistration=true

# API_PORT=8080

# Integration tests (optional — scripts/run-integration-tests.ps1 -UseCompose)
# Default password when unset: FlowBoard_Integration_Test1!
# MSSQL_SA_PASSWORD=YOUR_STRONG_SA_PASSWORD_HERE
